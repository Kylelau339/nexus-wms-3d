{
  "name": "nexus-wms-3d",
  "private": true,
  "version": "1.2.0",
  "type": "module",
  "description": "3D warehouse management & logistics full-process digital twin",
  "license": "MIT",
  "author": "Kyle",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kylelau339/nexus-wms-3d.git"
  },
  "homepage": "https://github.com/Kylelau339/nexus-wms-3d#readme",
  "bugs": {
    "url": "https://github.com/Kylelau339/nexus-wms-3d/issues"
  },
  "keywords": [
    "wms",
    "tms",
    "warehouse",
    "logistics",
    "digital-twin",
    "three.js",
    "typescript",
    "simulation",
    "i18n"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:a11y": "vitest run src/ui/__tests__/a11y.test.ts",
    "test:perf": "vitest run src/domain/__tests__/performance.test.ts",
    "audit:contrast": "node scripts/contrast-audit.mjs",
    "i18n:check": "node scripts/i18n-check.mjs",
    "i18n:keys": "node scripts/i18n-scan.mjs src --keys",
    "og": "node scripts/generate-og.mjs",
    "screenshots": "node scripts/generate-screenshots.mjs",
    "audit:selfcontained": "node scripts/selfcontained-check.mjs",
    "audit:responsive": "node scripts/responsive-audit.mjs",
    "predeploy": "node scripts/predeploy.mjs"
  },
  "dependencies": {
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@types/three": "^0.187.0",
    "happy-dom": "^21.0.4",
    "playwright": "^1.64.1",
    "typescript": "^5.7.3",
    "vite": "^6.0.7",
    "vitest": "^2.1.8"
  }
}
