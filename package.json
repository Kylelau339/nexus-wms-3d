{
  "name": "nexus-wms-3d",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "3D warehouse management & logistics full-process digital twin",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "audit:contrast": "node scripts/contrast-audit.mjs",
    "i18n:check": "node scripts/i18n-check.mjs",
    "i18n:keys": "node scripts/i18n-scan.mjs src --keys",
    "predeploy": "node scripts/predeploy.mjs"
  },
  "dependencies": {
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@types/three": "^0.187.0",
    "typescript": "^5.7.3",
    "vite": "^6.0.7",
    "vitest": "^2.1.8"
  }
}
